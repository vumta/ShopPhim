    Dim countRange_annual As Range, criteriaRange_annual As Range
    Dim departmentRange As Range, teamRange As Range
    Dim titleRange As Range, GradeDisRange As Range
    Dim ProDemoRange As Range, GradeProDemoRange As Range
    
    Dim result As Long
    Dim i As Integer, j As Integer, start As Integer, last As Integer
    Dim uniqueValues As Variant, cellValue As Variant
    Dim targetCell As Range, Found As Range
    Dim criteria As String, SearchKey As String, text As String
    
    ' Khai báo cho đếm chính xác Grade
    Dim exactGradeRange As Range
    Dim gradeArray() As String
    Dim k As Integer
    Dim tempResult As Long
    
    '====================== STAFF PROCESSING ======================
    Set wsDist_Staff = ThisWorkbook.Sheets("Staff_Distribution")
    Set wsEvaMap_Staff = ThisWorkbook.Sheets("Staff_EvaMap&Promo
